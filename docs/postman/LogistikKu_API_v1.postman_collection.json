        {
          "name": "GET Cek Kecukupan Stok Real-Time (POS/Kasir)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status adalah 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Respon memuat status ketersediaan stok real-time', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
