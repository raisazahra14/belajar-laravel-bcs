{
  "info": {
    "_postman_id": "a1e4d580-7b2f-4c9d-8a11-405060708090",
    "name": "LogistikKu RESTful API v1",
    "description": "Koleksi resmi pengujian RESTful API LogistikKu (/api/v1) — Periode 4 MagangHub Kemnaker RI. Mencakup autentikasi Laravel Sanctum dengan Token Abilities, Master Barang & Real-Time Stock Check, Mutasi & Transfer Stok Antar-Gudang, serta Pengadaan Terpadu (Purchase Order & Barcode Goods Receipt).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearer_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01. Status & Health Contract",
      "item": [
        {
          "name": "GET API v1 Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status adalah 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Header X-API-Version adalah v1.0', function () {",
                  "    pm.expect(pm.response.headers.get('X-API-Version')).to.eql('v1.0');",
                  "});",
                  "pm.test('Struktur JSON sesuai Unified API Response Contract', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json).to.have.all.keys('success', 'message', 'data', 'meta');",
                  "    pm.expect(json.meta.version).to.eql('v1.0');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "02. Autentikasi Sanctum & Token Abilities",
      "item": [
        {
          "name": "POST Login & Issue Sanctum Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status adalah 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Respon memuat Bearer Token dan Token Abilities sesuai role', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.data.token_type).to.eql('Bearer');",
                  "    pm.expect(json.data.abilities).to.be.an('array').and.not.empty;",
                  "    pm.expect(json.data.user).to.not.have.property('password');",
                  "    pm.environment.set('bearer_token', json.data.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\",\n  \"device_name\": \"Postman-Runner-v1\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "GET Profil Pengguna Aktif (/auth/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status adalah 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Data sensitif password dan remember_token disembunyikan', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.have.property('token_abilities');",
                  "    pm.expect(json.data).to.not.have.property('password');",
                  "    pm.expect(json.data).to.not.have.property('remember_token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        },
        {
          "name": "POST Logout & Cabut Token Aktif",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status adalah 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Token berhasil dicabut', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "03. Master Barang & Ketersediaan Stok Real-Time",
      "item": [
        {
          "name": "GET Daftar Barang (Filter, Search, Paginasi)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status adalah 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Respon terpaginasi dengan metadata HATEOAS links', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.be.an('array');",
                  "    pm.expect(json.meta).to.include.keys('current_page', 'per_page', 'total', 'last_page', 'links');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
