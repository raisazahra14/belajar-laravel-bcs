    {
      "name": "04. Mutasi & Transfer Stok Antar-Gudang",
      "item": [
        {
          "name": "POST Penyesuaian Stok Masuk/Keluar (/stok/adjust)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status adalah 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Respon memuat StockTransactionResource', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.include.keys('id', 'barang_id', 'jenis', 'jumlah', 'stok_sebelum', 'stok_sesudah');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"barang_id\": {{barang_id}},\n  \"warehouse_id\": {{warehouse_id}},\n  \"jenis\": \"masuk\",\n  \"jumlah\": 5,\n  \"reference_type\": \"DO\",\n  \"reference_number\": \"DO-POSTMAN-{{$timestamp}}\",\n  \"keterangan\": \"Penyesuaian stok dari pengujian Postman\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/stok/adjust",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "stok", "adjust"]
            }
          }
        },
        {
          "name": "POST Transfer Stok Antar-Gudang (/stok/transfer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status adalah 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Respon memuat nomor referensi unik dan transaksi keluar/masuk', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.include.keys('transfer_group_uuid', 'reference_number', 'transactions');",
                  "    pm.expect(json.data.transactions).to.include.keys('out', 'in');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"barang_id\": {{barang_id}},\n  \"source_warehouse_id\": {{warehouse_id}},\n  \"destination_warehouse_id\": {{destination_warehouse_id}},\n  \"jumlah\": 2,\n  \"keterangan\": \"Transfer stok otomatis antar-gudang\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/stok/transfer",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "stok", "transfer"]
            }
          }
        }
      ]
    },
    {
      "name": "05. Pengadaan Terpadu (Purchase Order & Goods Receipt)",
      "item": [
        {
          "name": "GET Daftar Purchase Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status adalah 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Daftar PO terpaginasi dan tidak membocorkan email internal creator', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.be.an('array');",
                  "    if (json.data.length > 0 && json.data[0].creator) {",
                  "        pm.expect(json.data[0].creator).to.not.have.property('email');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/purchase-orders?per_page=10",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "purchase-orders"],
              "query": [
                {
                  "key": "per_page",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "POST Buat Purchase Order Baru",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status adalah 201 Created dengan Header Location', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.headers.has('Location')).to.be.true;",
                  "});",
                  "pm.test('Respon memuat PurchaseOrderResource berstatus draft', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.status.value).to.eql('draft');",
                  "    pm.environment.set('purchase_order_id', json.data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplier_id\": {{supplier_id}},\n  \"warehouse_id\": {{warehouse_id}},\n  \"tanggal_pesan\": \"2026-11-20\",\n  \"estimasi_tiba\": \"2026-11-27\",\n  \"catatan\": \"Pengadaan melalui Postman API v1\",\n  \"items\": [\n    {\n      \"barang_id\": {{barang_id}},\n      \"jumlah_pesan\": 5,\n      \"harga_satuan\": 250000\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/purchase-orders",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "purchase-orders"]
            }
          }
        },
        {
          "name": "GET Detail Purchase Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP Status adalah 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Respon memuat detail item dan riwayat status PO', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.include.keys('id', 'nomor_po', 'status', 'items');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/purchase-orders/{{purchase_order_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "purchase-orders", "{{purchase_order_id}}"]
            }
          }
        },
        {
          "name": "POST Penerimaan Barang via Barcode Scanner (/receive)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Respon memiliki kontrak JSON standar (200 OK atau 422 bila masih draft)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 422]);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('success');",
                  "    pm.expect(json).to.have.property('message');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"barcode\": \"{{barcode_sample}}\",\n  \"jumlah_diterima\": 1,\n  \"nomor_surat_jalan\": \"SJ-PM-001\",\n  \"receipt_token\": \"SCAN-PM-{{$timestamp}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/purchase-orders/{{purchase_order_id}}/receive",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "purchase-orders", "{{purchase_order_id}}", "receive"]
            }
          }
        }
      ]
    }
  ]
